{
  "name": "java-doc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/compile-content.mjs && node scripts/compile-tasks.mjs",
    "compile-content": "node scripts/compile-content.mjs",
    "compile-tasks": "node scripts/compile-tasks.mjs",
    "typecheck": "tsc -b",
    "prebuild": "node scripts/compile-content.mjs && node scripts/compile-tasks.mjs",
    "build": "tsc -b && vite build",
    "test:verify": "node scripts/verify-examples.mjs",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "test:redesign": "npm run build && node scripts/verify-redesign.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/marked": "^5.0.2",
    "firebase": "^13.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "minisearch": "^7.2.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
