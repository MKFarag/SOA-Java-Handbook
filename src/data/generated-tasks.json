      },
      {
        "number": 8,
        "text": "Configure the nodes.",
        "links": []
      },
      {
        "number": 9,
        "text": "In the first application, use this code in the Compute node to receive the data:",
        "links": [
          {
            "topicId": "topic-151",
            "slug": "compute-node-esql-transform",
            "title": "Compute Node: Transform Messages with ESQL",
            "part": "Part 5: ACE & MQ"
          }
        ],
        "blocks": [
          {
            "type": "code",
            "language": "esql",
            "code": "SET OutputRoot.JSON.Data.Id = UUIDASCHAR;\nSET OutputRoot.JSON.Data.FirstName = InputRoot.JSON.Data.FirstName;\nSET OutputRoot.JSON.Data.LastName = InputRoot.JSON.Data.LastName;"
          }
        ]
      },
      {
        "number": 10,
        "text": "In the second application, add this code:",
        "links": [],
        "blocks": [
          {
            "type": "code",
            "language": "esql",
            "code": "SET OutputRoot.JSON.Data.Id = InputRoot.JSON.Data.Id;\nSET OutputRoot.JSON.Data.FullName =\n    InputRoot.JSON.Data.FirstName || ' ' || InputRoot.JSON.Data.LastName;"
          }
        ]
      },
